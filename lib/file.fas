use linux "sys/linux.fas"

value struct File {
    data addr
    size usize
}

fn load_file[ALIGNMENT const usize](arena addr, path addr, padding usize) File fails {
    fd i32 = try os_open(path)
    defer { os_close(fd) }

    checkpoint usize = arena[Arena].used
    errdefer { arena[Arena].used = checkpoint }

    data addr = try arena_alloc[ALIGNMENT](arena, 0)
    available usize = arena_remaining(arena)
    if available < padding { fail OutOfMemory }
    available -= padding

    size usize = 0
    while true {
        if size == available { fail OutOfMemory }
        read usize = try os_read(fd, data + size, available - size)
        if read == 0 { break }
        size += read
    }

    try arena_alloc[1](arena, size + padding)
    for i usize = 0; i < padding; i += 1 {
        (data + size)[u8, i] = 0
    }

    return { data, size }
}
