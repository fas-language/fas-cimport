use linux "sys/linux.fas"

error FileOpenFailed, FileSizeFailed, FileReadFailed, UnexpectedEof

struct File {
    data addr
    size usize
}

fn load_file(arena addr, path addr, alignment usize, padding usize, out addr) fails {
    out[File].data = null
    out[File].size = 0

    fd i64 = os_open(path)
    if fd < 0 { fail FileOpenFailed }
    defer { os_close(fd) }

    length i64 = os_file_size(fd)
    if length < 0 { fail FileSizeFailed }

    size usize = bitcast[usize](length)
    if padding > arena[Arena].capacity { fail OutOfMemory }
    if size > arena[Arena].capacity - padding { fail OutOfMemory }

    checkpoint usize = arena[Arena].used
    data addr = try arena_alloc(arena, size + padding, alignment)
    errdefer { arena[Arena].used = checkpoint }

    total usize = 0
    while total < size {
        n i64 = os_read(fd, data + total, size - total)
        if n < 0 { fail FileReadFailed }
        if n == 0 { fail UnexpectedEof }

        total += bitcast[usize](n)
    }

    for i usize = 0; i < padding; i += 1 {
        (data + size)[u8, i] = 0
    }

    out[File].data = data
    out[File].size = size
}
