use linux "sys/linux.fas"

const READ_PADDING usize = 64

struct Reader {
    fd i32
    buffer addr                                 // capacity + READ_PADDING bytes
    capacity usize
}

value struct Chunk {
    data addr
    size usize
}

struct ReadBuffer[N const usize] @align(64) {
    bytes arr[N + READ_PADDING, u8]
}

fn reader_next(reader addr) Chunk fails {
    view r = reader[Reader]

    size usize = try os_read(r.fd, r.buffer, r.capacity)
    (r.buffer + size)[vec[64, u8]] = splat(0)

    return {r.buffer, size}
}

struct Writer {
    fd i32
    buffer addr
    capacity usize
    used usize
    err error
}

fn writer_flush(writer addr) fails {
    view w = writer[Writer]
    if bitcast[u32](w.err) != 0 { fail w.err }

    os_write(w.fd, w.buffer, w.used) catch e {
        w.err = e
        fail e
    }

    w.used = 0
}

fn put_bytes(writer addr, data addr, size usize) void {
    view w = writer[Writer]

    if size > w.capacity - w.used {
        writer_flush(writer) catch { return }
        // too big too bufer, write directly
        if size >= w.capacity {
            os_write(w.fd, data, size) catch e { w.err = e }
            return
        }
    }

    for i usize = 0; i < size; i += 1 {
        (w.buffer + w.used)[u8, i] = data[u8, i]
    }
    w.used += size
}

fn put_byte(writer addr, byte u8) void {
    view w = writer[Writer]

    if w.used >= w.capacity {
        put_bytes(writer, &byte, 1)
        return
    }

    w.buffer[u8, w.used] = byte
    w.used += 1
}

fn put_u64(writer addr, value u64) void {
    digits arr[20, u8] = {}
    i usize = len(digits)

    while true {
        i -= 1
        digits[i] = trunc[u8](value % 10) + '0'
        value /= 10
        if value == 0 { break }
    }

    put_bytes(writer, &digits + i, len(digits) - i)
}

fn put_str(writer addr, str addr) void {
    size usize = 0
    while str[u8, size] != 0 { size += 1 }
    put_bytes(writer, str, size)
}
