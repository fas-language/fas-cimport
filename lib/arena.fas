use linux "sys/linux.fas"

error OutOfMemory, BadAlignment

struct Arena {
    base addr
    used usize
    capacity usize
}

fn arena_init(arena addr, capacity usize) fails {
    arena[Arena].base = try os_reserve(capacity)
    arena[Arena].used = 0
    arena[Arena].capacity = capacity
}

fn arena_alloc[ALIGNMENT const usize](arena addr, size usize) addr fails {
    if ALIGNMENT == 0 || (ALIGNMENT & (ALIGNMENT - 1)) != 0 { fail BadAlignment }

    view a = arena[Arena]

    current usize = addr_bits(a.base + a.used)
    padding usize = (ALIGNMENT - (current & (ALIGNMENT - 1))) & (ALIGNMENT - 1)

    remaining usize = a.capacity - a.used
    if padding > remaining || size > remaining - padding { fail OutOfMemory }

    result addr = a.base + a.used + padding
    a.used += padding + size

    return result
}

fn arena_remaining(arena addr) usize {
    return arena[Arena].capacity - arena[Arena].used
}
