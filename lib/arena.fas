use linux "sys/linux.fas"

error OutOfMemory, BadAlignment

struct Arena {
    base addr
    used usize
    capacity usize
}

fn arena_init(arena addr, capacity usize) fails {
    base addr = os_reserve(capacity)
    if base == null { fail OutOfMemory }

    arena[Arena].base = base
    arena[Arena].used = 0
    arena[Arena].capacity = capacity
}

fn arena_alloc(arena addr, size usize, alignment usize) addr fails {
    if alignment == 0 || (alignment & (alignment - 1)) != 0 { fail BadAlignment }

    view a = arena[Arena]

    if a.used > a.capacity { fail OutOfMemory }

    current usize = addr_bits(a.base + a.used)
    padding usize = (alignment - (current & (alignment - 1))) & (alignment - 1)

    remaining usize = a.capacity - a.used
    if padding > remaining { fail OutOfMemory }
    if size > remaining - padding { fail OutOfMemory }

    result addr = a.base + a.used + padding
    a.used += padding + size

    return result
}
