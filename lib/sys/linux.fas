const SYS_READ u64 = 0
const SYS_WRITE u64 = 1
const SYS_CLOSE u64 = 3
const SYS_MMAP u64 = 9
const SYS_OPENAT u64 = 257

const PROT_READ i32 = 1
const PROT_WRITE i32 = 2

const MAP_PRIVATE i32 = 2
const MAP_ANONYMOUS i32 = 32
const MAP_NORESERVE i32 = 0x4000

const AT_FDCWD i32 = -100

const O_RDONLY i32 = 0
const O_CLOEXEC i32 = 0x80000

error Interrupted = 4, IoError = 5, NotFound = 2, IsDirectory = 21

fn os_reserve(size usize) addr fails {
    return try syscall[addr fails](SYS_MMAP, 0, size, PROT_READ | PROT_WRITE, MAP_PRIVATE | MAP_ANONYMOUS | MAP_NORESERVE, -1, 0)
}

fn os_open(path addr) i32 fails {
    return trunc[i32](try syscall[fails](SYS_OPENAT, AT_FDCWD, path, O_RDONLY | O_CLOEXEC, 0))
}

fn os_read(fd i32, destination addr, size usize) usize fails {
    while true {
        read u64 = syscall[u64 fails](SYS_READ, fd, destination, size) catch e {
            if e == Interrupted { continue }
            fail e
        }
        return read
    }
}

fn os_close(fd i64) void {
    syscall(SYS_CLOSE, fd)
}

fn os_write(fd i32, data addr, size usize) fails {
    done usize = 0

    while done < size {

        written u64 = syscall[u64 fails](SYS_WRITE, fd, data + done, size - done) catch e {
            if e == Interrupted { continue }
            fail e
        }

        if written == 0 { fail IoError }
        done += bitcast[usize](written)
    }

}
