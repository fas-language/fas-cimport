const SYS_MMAP u64 = 9
const SYS_OPENAT u64 = 257
const SYS_READ u64 = 0
const SYS_CLOSE u64 = 3
const SYS_FSTAT u64 = 5
const SYS_WRITE u64 = 1

const EINTR i64 = 4
const EIO i64 = 5

const PROT_READ i32 = 1
const PROT_WRITE i32 = 2

const MAP_PRIVATE i32 = 2
const MAP_ANONYMOUS i32 = 32
const MAP_NORESERVE i32 = 0x4000

const AT_FDCWD i32 = -100

fn os_reserve(size usize) addr {
    r i64 = syscall(SYS_MMAP, 0, size, PROT_READ | PROT_WRITE, MAP_PRIVATE | MAP_ANONYMOUS | MAP_NORESERVE, -1, 0)
    if r < 0 { return null }
    return addr_from_bits(bitcast[usize](r))
}

fn os_open(path addr) i64 {
    return syscall(SYS_OPENAT, AT_FDCWD, path, 0, 0)
}

fn os_read(fd i64, dst addr, size usize) i64 {
    while true {
        n i64 = syscall(SYS_READ, fd, dst, size)
        if n != -4 { return n }
    }
}

fn os_close(fd i64) void {
    syscall(SYS_CLOSE, fd)
}

fn os_file_size(fd i64) i64 {
    // stat struct -> https://github.com/torvalds/linux/blob/master/arch/x86/include/uapi/asm/stat.h
    stat arr[144, u8] = {}
    if syscall(SYS_FSTAT, fd, &stat) < 0 {
       return -1
    }
    // offset 48 is st_size
    return (&stat + 48)[i64]
}

fn os_write(fd i32, p addr, n usize) i64 {
    done usize = 0

    while done < n {
        r i64 = syscall(SYS_WRITE, fd, p + done, n - done)
        if r == -EINTR { continue }
        if r < 0 { return r }
        if r == 0 { return -EIO }
        done += bitcast[usize](r)
    }

    return bitcast[i64](done)
}
