use "lib/arena.fas"
use "lib/file.fas"
use "lib/io.fas"

error Usage

const ARENA_SIZE usize = 4 * 1024 * 1024 * 1024
const FILE_ALIGN usize = 64
const FILE_PADDING usize = 64

fn main(argc i32, argv addr) i32 fails {
    if argc < 2 { fail Usage }

    arena Arena = {}
    try arena_init(&arena, ARENA_SIZE)

    file File = try load_file[FILE_ALIGN](&arena, argv[addr, 1], FILE_PADDING)

    count u64 = 0
    mask vec[32, u8] = splat('\n')

    for i usize = 0; i < file.size; i += 32 {
        values vec[32, u8] = (file.data + i)[vec[32, u8]]
        result vec[32, bool] = values == mask
        count += popcount(bitcast[u32](result))
    }

    buffer arr[64, u8] = {}
    output Writer = { .fd = 1, .buffer = &buffer, .capacity = len(buffer) }

    put_u64(&output, count)
    put_byte(&output, ' ')
    put_u64(&output, file.size)
    put_byte(&output, '\n')

    try writer_flush(&output)

    return 0
}
