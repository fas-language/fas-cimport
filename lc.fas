use "lib/arena.fas"
use "lib/file.fas"
use "lib/io.fas"

const ARENA_SIZE usize = 4 * 1024 * 1024 * 1024
const FILE_ALIGN usize = 64
const FILE_PADDING usize = 64

fn main(argc i32, argv addr) i32 {
    if argc < 2 { return 1 }

    arena Arena = {}
    arena_init(&arena, ARENA_SIZE) catch e {
        write_str(2, err_name(e))
        write_str(2, c"\n")
        return 2
    }

    file File = {}
    load_file(&arena, argv[addr, 1], FILE_ALIGN, FILE_PADDING, &file) catch e {
        write_str(2, argv[addr, 1])
        write_str(2, c": ")
        write_str(2, err_name(e))
        write_str(2, c"\n")
        return 3
    }

    i usize = 0
    count u64 = 0
    mask vec[32, u8] = splat('\n')
    while i < file.size {
        values vec[32, u8] = (file.data + i)[vec[32, u8]]
        result vec[32, bool] = values == mask

        count += popcount(bitcast[u32](result))
        i += 32
    }

    write_u64(1, count)
    write_str(1, c" ")
    write_u64(1, file.size)
    write_str(1, c"\n")

    return 0
}
