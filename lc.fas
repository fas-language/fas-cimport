use "C" <stdio.h>
use linux "lib/arena.fas"

const ARENA_SIZE usize = 4 * 1024 * 1024 * 1024
const FILE_ALIGN usize = 64
const FILE_PADDING usize = 64

fn main(argc i32, argv addr) i32 {
    if argc < 2 { return 1 }

    arena Arena = {}
    if !arena_init(&arena, ARENA_SIZE) {
        return 2
    }

    return 0
}
